From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nitrux <hello@nxos.org>
Date: Mon, 2 Nov 2026 00:00:00 -0600
Subject: [PATCH] Add Nitrux Aesthetic FHS directory filtering

Add an optional VFS directory-entry filter for Nitrux's Aesthetic FHS
layout. Hidden entries are scoped to the current mount namespace and are
keyed by filesystem device and inode. Direct path access is unchanged.

Builds with the feature enabled include an A_FHS marker in the kernel
version reported by uname.

The userspace control interface is a Generic Netlink family named
"aesthetic_fhs". It supports hide, unhide, list, and flush operations.

---
 fs/Kconfig                         |  13 +
 fs/Makefile                        |   1 +
 fs/aesthetic_fhs.c                 | 398 +++++++++++++++++++++++++++++
 init/Makefile                      |   3 +-
 fs/namei.c                         |  10 +-
 fs/namespace.c                     |   2 +
 fs/readdir.c                       |  38 ++++
 include/linux/aesthetic_fhs.h      |  30 +++
 include/uapi/linux/aesthetic_fhs.h |  27 +++
 9 files changed, 516 insertions(+), 6 deletions(-)

diff --git a/fs/Kconfig b/fs/Kconfig
--- a/fs/Kconfig
+++ b/fs/Kconfig
@@ -9,6 +9,19 @@ menu "File systems"
 config DCACHE_WORD_ACCESS
        bool
 
+config NITRUX_AESTHETIC_FHS
+	bool "Nitrux Aesthetic FHS directory filtering"
+	depends on NET
+	default n
+	help
+	  Hide selected directory entries from directory enumeration while
+	  preserving direct access to their paths. Entries are scoped to the
+	  current mount namespace and are controlled through the aesthetic_fhs
+	  Generic Netlink family.
+
+	  This is intended for cosmetic filesystem hierarchy presentation and
+	  is not an access-control mechanism.
+
 config VALIDATE_FS_PARSER
 	bool "Validate filesystem parameter description"
 	help
