 preempt-flag-$(CONFIG_PREEMPT_RT)	:= PREEMPT_RT
@@ -37,1 +38,1 @@
-	utsver=$$(echo '$(pound)'"$(build-version)" $(smp-flag-y) $(preempt-flag-y) "$(build-timestamp)" | cut -b -64); \
+	utsver=$$(echo '$(pound)'"$(build-version)" $(smp-flag-y) $(preempt-flag-y) $(aesthetic-fhs-flag-y) "$(build-timestamp)" | cut -b -64); \
diff --git a/fs/aesthetic_fhs.c b/fs/aesthetic_fhs.c
new file mode 100644
--- /dev/null
+++ b/fs/aesthetic_fhs.c
@@ -0,0 +1,398 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Nitrux Aesthetic FHS directory filtering.
+ */
+
+#include <linux/capability.h>
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/namei.h>
+#include <linux/nsproxy.h>
+#include <linux/rwsem.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+#include <net/genetlink.h>
+#include <uapi/linux/aesthetic_fhs.h>
+
+#include <linux/aesthetic_fhs.h>
+#include "mount.h"
+
+struct aesthetic_fhs_entry {
+	struct list_head list;
+	struct mnt_namespace *mnt_ns;
+	dev_t dev;
+	u64 ino;
+	char *path;
+};
+
+static int aesthetic_fhs_admin(void)
+{
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+
+	return 0;
+}
+
+struct aesthetic_fhs_target {
+	struct mnt_namespace *mnt_ns;
+	dev_t dev;
+	u64 ino;
+};
+
+static LIST_HEAD(aesthetic_fhs_entries);
+static DECLARE_RWSEM(aesthetic_fhs_lock);
+static struct genl_family aesthetic_fhs_family;
+
+static const struct nla_policy aesthetic_fhs_policy[AESTHETIC_FHS_ATTR_MAX + 1] = {
+	[AESTHETIC_FHS_ATTR_PATH] = {
+		.type = NLA_NUL_STRING,
+		.len = PATH_MAX - 1,
+	},
+};
+
+static struct mnt_namespace *aesthetic_fhs_path_namespace(const struct path *path)
+{
+	struct mount *mount = real_mount(path->mnt);
+
+	if (IS_ERR_OR_NULL(mount->mnt_ns))
+		return NULL;
+
+	return mount->mnt_ns;
+}
+
+static int aesthetic_fhs_resolve(const char *name,
+				 struct aesthetic_fhs_target *target)
+{
+	struct path parent;
+	struct dentry *dentry;
+	struct inode *inode;
+	int ret;
+
+	if (name[0] != '/')
+		return -EINVAL;
+
+	dentry = kern_path_parent(name, &parent);
+	if (IS_ERR(dentry))
+		return PTR_ERR(dentry);
+
+	inode = d_inode(dentry);
+	if (!inode) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	target->mnt_ns = aesthetic_fhs_path_namespace(&parent);
+	if (!target->mnt_ns) {
+		ret = -ENOENT;
+		goto out;
+	}
+
+	target->dev = parent.mnt->mnt_sb->s_dev;
+	target->ino = inode->i_ino;
+	ret = 0;
+out:
+	dput(dentry);
+	path_put(&parent);
+	return ret;
+}
+
+static bool aesthetic_fhs_entry_matches(const struct aesthetic_fhs_entry *entry,
+					const struct aesthetic_fhs_target *target)
+{
+	return entry->mnt_ns == target->mnt_ns &&
+		entry->dev == target->dev && entry->ino == target->ino;
+}
+
+bool aesthetic_fhs_should_hide(const struct file *file, u64 ino)
+{
+	struct mnt_namespace *mnt_ns;
+	struct aesthetic_fhs_entry *entry;
+	bool hidden = false;
+
+	if (!file || !file->f_path.mnt)
+		return false;
+
+	mnt_ns = aesthetic_fhs_path_namespace(&file->f_path);
+	if (!mnt_ns)
+		return false;
+
+	down_read(&aesthetic_fhs_lock);
+	list_for_each_entry(entry, &aesthetic_fhs_entries, list) {
+		if (entry->mnt_ns == mnt_ns &&
+		    entry->dev == file->f_path.mnt->mnt_sb->s_dev &&
+		    entry->ino == ino) {
+			hidden = true;
+			break;
+		}
+	}
+	up_read(&aesthetic_fhs_lock);
+
+	return hidden;
+}
+
+void aesthetic_fhs_inode_deleted(struct inode *inode)
+{
+	struct aesthetic_fhs_entry *entry, *tmp;
+	struct mnt_namespace *mnt_ns;
+
+	if (!inode || !current->nsproxy)
+		return;
+
+	mnt_ns = current->nsproxy->mnt_ns;
+	down_write(&aesthetic_fhs_lock);
+	list_for_each_entry_safe(entry, tmp, &aesthetic_fhs_entries, list) {
+		if (entry->mnt_ns == mnt_ns &&
+		    entry->dev == inode->i_sb->s_dev &&
+		    entry->ino == inode->i_ino) {
+			list_del(&entry->list);
+			kfree(entry->path);
+			kfree(entry);
+		}
+	}
+	up_write(&aesthetic_fhs_lock);
+}
+
+void aesthetic_fhs_namespace_exit(struct mnt_namespace *mnt_ns)
+{
+	struct aesthetic_fhs_entry *entry, *tmp;
+
+	down_write(&aesthetic_fhs_lock);
+	list_for_each_entry_safe(entry, tmp, &aesthetic_fhs_entries, list) {
+		if (entry->mnt_ns == mnt_ns) {
+			list_del(&entry->list);
+			kfree(entry->path);
+			kfree(entry);
+		}
+	}
+	up_write(&aesthetic_fhs_lock);
+}
+
+static int aesthetic_fhs_get_path(struct genl_info *info, char **path)
+{
+	struct nlattr *attr = info->attrs[AESTHETIC_FHS_ATTR_PATH];
+
+	if (!attr || !nla_len(attr) || nla_len(attr) > PATH_MAX)
+		return -EINVAL;
+
+	*path = kmemdup_nul(nla_data(attr), nla_len(attr), GFP_KERNEL);
+	if (!*path)
+		return -ENOMEM;
+
+	if ((*path)[0] != '/') {
+		kfree(*path);
+		*path = NULL;
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int aesthetic_fhs_hide(struct sk_buff *skb, struct genl_info *info)
+{
+	struct aesthetic_fhs_target target;
+	struct aesthetic_fhs_entry *new_entry, *entry;
+	char *path;
+	int ret;
+
+	ret = aesthetic_fhs_admin();
+	if (ret)
+		return ret;
+
+	ret = aesthetic_fhs_get_path(info, &path);
+	if (ret)
+		return ret;
+
+	ret = aesthetic_fhs_resolve(path, &target);
+	if (ret)
+		goto out_path;
+
+	new_entry = kmalloc(sizeof(*new_entry), GFP_KERNEL);
+	if (!new_entry) {
+		ret = -ENOMEM;
+		goto out_path;
+	}
+
+	new_entry->path = path;
+	new_entry->mnt_ns = target.mnt_ns;
+	new_entry->dev = target.dev;
+	new_entry->ino = target.ino;
+
+	down_write(&aesthetic_fhs_lock);
+	list_for_each_entry(entry, &aesthetic_fhs_entries, list) {
+		if (entry->mnt_ns == target.mnt_ns &&
+		    entry->dev == target.dev && entry->ino == target.ino) {
+			ret = -EEXIST;
+			goto duplicate;
+		}
+	}
+
+	list_add_tail(&new_entry->list, &aesthetic_fhs_entries);
+	ret = 0;
+	goto unlock;
+
+duplicate:
+	kfree(new_entry->path);
+	kfree(new_entry);
+unlock:
+	up_write(&aesthetic_fhs_lock);
+	return ret;
+
+out_path:
+	kfree(path);
+	return ret;
+}
+
+static int aesthetic_fhs_unhide(struct sk_buff *skb, struct genl_info *info)
+{
+	struct aesthetic_fhs_target target;
+	struct aesthetic_fhs_entry *entry, *tmp;
+	char *path;
+	int ret;
+
+	ret = aesthetic_fhs_admin();
+	if (ret)
+		return ret;
+
+	ret = aesthetic_fhs_get_path(info, &path);
+	if (ret)
+		return ret;
+
+	ret = aesthetic_fhs_resolve(path, &target);
+	if (ret)
+		goto out_path;
+
+	ret = -ENOENT;
+	down_write(&aesthetic_fhs_lock);
+	list_for_each_entry_safe(entry, tmp, &aesthetic_fhs_entries, list) {
+		if (aesthetic_fhs_entry_matches(entry, &target)) {
+			list_del(&entry->list);
+			kfree(entry->path);
+			kfree(entry);
+			ret = 0;
+			break;
+		}
+	}
+	up_write(&aesthetic_fhs_lock);
+
+out_path:
+	kfree(path);
+	return ret;
+}
+
+static int aesthetic_fhs_flush(struct sk_buff *skb, struct genl_info *info)
+{
+	struct aesthetic_fhs_entry *entry, *tmp;
+	struct mnt_namespace *mnt_ns;
+
+	if (aesthetic_fhs_admin())
+		return -EPERM;
+
+	if (!current->nsproxy)
+		return -EINVAL;
+
+	mnt_ns = current->nsproxy->mnt_ns;
+	down_write(&aesthetic_fhs_lock);
+	list_for_each_entry_safe(entry, tmp, &aesthetic_fhs_entries, list) {
+		if (entry->mnt_ns == mnt_ns) {
+			list_del(&entry->list);
+			kfree(entry->path);
+			kfree(entry);
+		}
+	}
+	up_write(&aesthetic_fhs_lock);
+
+	return 0;
+}
+
+static int aesthetic_fhs_list(struct sk_buff *skb,
+			      struct netlink_callback *cb)
+{
+	struct aesthetic_fhs_entry *entry;
+	struct mnt_namespace *mnt_ns;
+	void *hdr;
+	unsigned long index = 0;
+	unsigned long skip = cb->args[0];
+
+	if (aesthetic_fhs_admin())
+		return -EPERM;
+
+	if (!current->nsproxy)
+		return 0;
+
+	mnt_ns = current->nsproxy->mnt_ns;
+	down_read(&aesthetic_fhs_lock);
+	list_for_each_entry(entry, &aesthetic_fhs_entries, list) {
+		if (entry->mnt_ns != mnt_ns)
+			continue;
+		if (index++ < skip)
+			continue;
+
+		hdr = genlmsg_put(skb, NETLINK_CB(cb->skb).portid,
+				  cb->nlh->nlmsg_seq, &aesthetic_fhs_family,
+				  NLM_F_MULTI, AESTHETIC_FHS_CMD_LIST);
+		if (!hdr || nla_put_string(skb, AESTHETIC_FHS_ATTR_PATH,
+					   entry->path)) {
+			if (hdr)
+				genlmsg_cancel(skb, hdr);
+			break;
+		}
+		genlmsg_end(skb, hdr);
+		cb->args[0] = index;
+	}
+	up_read(&aesthetic_fhs_lock);
+
+	return skb->len;
+}
+
+static const struct genl_ops aesthetic_fhs_ops[] = {
+	{
+		.cmd = AESTHETIC_FHS_CMD_HIDE,
+		.doit = aesthetic_fhs_hide,
+	},
+	{
+		.cmd = AESTHETIC_FHS_CMD_UNHIDE,
+		.doit = aesthetic_fhs_unhide,
+	},
+	{
+		.cmd = AESTHETIC_FHS_CMD_FLUSH,
+		.doit = aesthetic_fhs_flush,
+	},
+	{
+		.cmd = AESTHETIC_FHS_CMD_LIST,
+		.dumpit = aesthetic_fhs_list,
+	},
+};
+
+static struct genl_family aesthetic_fhs_family __ro_after_init = {
+	.name = AESTHETIC_FHS_GENL_NAME,
+	.version = AESTHETIC_FHS_GENL_VERSION,
+	.maxattr = AESTHETIC_FHS_ATTR_MAX,
+	.policy = aesthetic_fhs_policy,
+	.netnsok = true,
+	.parallel_ops = true,
+	.module = THIS_MODULE,
+	.ops = aesthetic_fhs_ops,
+	.n_ops = ARRAY_SIZE(aesthetic_fhs_ops),
+};
+
+static int __init aesthetic_fhs_init(void)
+{
+	return genl_register_family(&aesthetic_fhs_family);
+}
+module_init(aesthetic_fhs_init);
+
+static void __exit aesthetic_fhs_exit(void)
+{
+	genl_unregister_family(&aesthetic_fhs_family);
+}
+module_exit(aesthetic_fhs_exit);
+
+MODULE_DESCRIPTION("Nitrux Aesthetic FHS directory filtering");
+MODULE_LICENSE("GPL");
diff --git a/fs/namei.c b/fs/namei.c
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -46,2 +46,3 @@
 #include "internal.h"
 #include "mount.h"
+#include <linux/aesthetic_fhs.h>
@@ -5525,5 +5525,7 @@ int vfs_rmdir(struct mnt_idmap *idmap, struct inode *dir,
-	dput(dentry);
-	if (!error)
-		d_delete_notify(dir, dentry);
+	if (!error) {
+		d_delete_notify(dir, dentry);
+		aesthetic_fhs_inode_deleted(dentry->d_inode);
+	}
+	dput(dentry);
 	return error;
 }
@@ -5661,6 +5661,7 @@ int vfs_unlink(struct mnt_idmap *idmap, struct inode *dir,
 	} else if (!error) {
 		fsnotify_link_count(target);
 		d_delete_notify(dir, dentry);
+		aesthetic_fhs_inode_deleted(target);
 	}
 
 	return error;
diff --git a/fs/namespace.c b/fs/namespace.c
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -38,2 +38,3 @@
 #include "pnode.h"
 #include "internal.h"
+#include <linux/aesthetic_fhs.h>
@@ -4352,4 +4352,5 @@ static void free_mnt_ns(struct mnt_namespace *ns)
 {
+	aesthetic_fhs_namespace_exit(ns);
