diff --git a/include/linux/aesthetic_fhs.h b/include/linux/aesthetic_fhs.h
new file mode 100644
--- /dev/null
+++ b/include/linux/aesthetic_fhs.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_AESTHETIC_FHS_H
+#define _LINUX_AESTHETIC_FHS_H
+
+#include <linux/types.h>
+
+struct file;
+struct inode;
+struct mnt_namespace;
+
+#ifdef CONFIG_NITRUX_AESTHETIC_FHS
+bool aesthetic_fhs_should_hide(const struct file *file, u64 ino);
+void aesthetic_fhs_inode_deleted(struct inode *inode);
+void aesthetic_fhs_namespace_exit(struct mnt_namespace *mnt_ns);
+#else
+static inline bool aesthetic_fhs_should_hide(const struct file *file, u64 ino)
+{
+	return false;
+}
+
+static inline void aesthetic_fhs_inode_deleted(struct inode *inode)
+{
+}
+
+static inline void aesthetic_fhs_namespace_exit(struct mnt_namespace *mnt_ns)
+{
+}
+#endif
