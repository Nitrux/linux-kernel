From 149097a9dfef01ec36e252cb59b20c7ddb7c3254 Mon Sep 17 00:00:00 2001
From: Ernesto Salvetti <ernesto.salvetti@tambosi.tn.it>
Date: Sat, 31 Oct 2026 12:59:12 +0100
Subject: [PATCH 3/3] Bluetooth: btusb: Disable broken LE extended scan on
 Barrot controllers

Barrot controllers advertise support for extended scanning and extended
connections but hang when those commands are used. Mark both capabilities
broken so the Bluetooth stack falls back to legacy commands.

Signed-off-by: Ernesto Salvetti <ernesto.salvetti@tambosi.tn.it>
---
 drivers/bluetooth/btusb.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
index bf9a93d5c..b84fa11fd 100644
--- a/drivers/bluetooth/btusb.c
+++ b/drivers/bluetooth/btusb.c
@@ -4451,6 +4451,12 @@ static int btusb_probe(struct usb_interface *intf,
 		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_WRITE_AUTH_PAYLOAD_TIMEOUT);
 	}
 
+	if (id->driver_info & BTUSB_BARROT) {
+		/* Support is advertised, but the controller hangs on it */
+		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_EXT_SCAN);
+		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_EXT_CREATE_CONN);
+	}
+
 	if (!reset)
 		hci_set_quirk(hdev, HCI_QUIRK_RESET_ON_CLOSE);
 
