# -- Collect meta-package artifacts.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK_DIR="${KERNEL_WORK_DIR:-$ROOT_DIR/work}"
OUTPUT_DIR="${KERNEL_OUTPUT_DIR:-$ROOT_DIR/output}"
mkdir -p "$OUTPUT_DIR"

find "$WORK_DIR" -type f -name '*.deb' -exec mv -f {} "$OUTPUT_DIR/" \;
