# -- Apply kernel configuration.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC_NAME="$(cat "$ROOT_DIR/work/source-dir")"
SRC_DIR="$ROOT_DIR/work/$SRC_NAME"


# -- Never wait for interactive input in this stage.

exec </dev/null

cd "$SRC_DIR"
cp "$ROOT_DIR/config" .config


# -- Resolve compiler-dependent options with the same LLVM toolchain used to build.

make LLVM=1 LLVM_IAS=1 olddefconfig

scripts/config -d MZEN4 -d X86_NATIVE_CPU
scripts/config -e GENERIC_CPU --set-val X86_64_VERSION 3
scripts/config -e CACHY
case "$KERNEL_LTO" in
    full)
        scripts/config -e LTO -e LTO_CLANG -d LTO_NONE -e LTO_CLANG_FULL -d LTO_CLANG_THIN
        ;;
    thin)
        scripts/config -e LTO -e LTO_CLANG -d LTO_NONE -d LTO_CLANG_FULL -e LTO_CLANG_THIN
        ;;
    none)
        scripts/config -d LTO -d LTO_CLANG -e LTO_NONE -d LTO_CLANG_FULL -d LTO_CLANG_THIN
        ;;
    *)
        echo "Error: KERNEL_LTO must be one of: none, thin, full"
        exit 1
        ;;
esac
case "$KERNEL_DEBUG_COMPRESSION" in
    none)
        scripts/config -e DEBUG_INFO_COMPRESSED_NONE -d DEBUG_INFO_COMPRESSED_ZLIB -d DEBUG_INFO_COMPRESSED_ZSTD
        ;;
    zlib)
        scripts/config -d DEBUG_INFO_COMPRESSED_NONE -e DEBUG_INFO_COMPRESSED_ZLIB -d DEBUG_INFO_COMPRESSED_ZSTD
        ;;
    zstd)
        scripts/config -d DEBUG_INFO_COMPRESSED_NONE -d DEBUG_INFO_COMPRESSED_ZLIB -e DEBUG_INFO_COMPRESSED_ZSTD
        ;;
    *)
        echo "Error: KERNEL_DEBUG_COMPRESSION must be one of: none, zlib, zstd"
        exit 1
        ;;
esac
scripts/config -e HZ_1000 --set-val HZ 1000
scripts/config -d HZ_PERIODIC -d NO_HZ_IDLE -d CONTEXT_TRACKING_FORCE -e NO_HZ_FULL_NODEF -e NO_HZ_FULL -e NO_HZ -e NO_HZ_COMMON -e CONTEXT_TRACKING
scripts/config -e PREEMPT_BUILD -d PREEMPT_NONE -d PREEMPT_VOLUNTARY -e PREEMPT -e PREEMPT_COUNT -e PREEMPTION -e PREEMPT_DYNAMIC
scripts/config -d CC_OPTIMIZE_FOR_PERFORMANCE -e CC_OPTIMIZE_FOR_PERFORMANCE_O3
scripts/config -e SCHED_CLASS_EXT
scripts/config -e I2C_CHARDEV
scripts/config -d AMD_PRIVATE_COLOR
scripts/config -d NOVA_CORE
scripts/config -e LRU_GEN -e LRU_GEN_ENABLED -d LRU_GEN_STATS
scripts/config -d TRANSPARENT_HUGEPAGE_MADVISE -e TRANSPARENT_HUGEPAGE_ALWAYS
scripts/config -e PER_VMA_LOCK -d PER_VMA_LOCK_STATS
scripts/config -e DAMON -e DAMON_VADDR -e DAMON_DBGFS -e DAMON_SYSFS -e DAMON_PADDR -e DAMON_RECLAIM -e DAMON_LRU_SORT
scripts/config -e ACPI_CALL -m LENOVO_WMI_EVENTS -m LENOVO_WMI_HELPERS -m LENOVO_WMI_GAMEZONE -m LENOVO_WMI_TUNING -m MSI_WMI_PLATFORM
scripts/config --set-val MODULE_COMPRESS_ZSTD_LEVEL 19 -e MODULE_COMPRESS_ZSTD_ULTRA --set-val MODULE_COMPRESS_ZSTD_LEVEL_ULTRA 22 --set-val ZSTD_COMP_VAL 22
scripts/config -e EFI_HANDOVER_PROTOCOL -e USER_NS


# -- Re-resolve dependencies and defaults after scripted toggles.

make LLVM=1 LLVM_IAS=1 olddefconfig


# -- Prepare generated headers/scripts for the build stage.

make LLVM=1 LLVM_IAS=1 prepare
