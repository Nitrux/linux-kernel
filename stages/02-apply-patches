# -- Apply kernel patch series.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC_NAME="$(cat "$ROOT_DIR/work/source-dir")"
SRC_DIR="$ROOT_DIR/work/$SRC_NAME"
SERIES_FILE="$ROOT_DIR/patches/series"

cd "$SRC_DIR"

if [ -f "$SERIES_FILE" ]; then
    while IFS= read -r patch_name || [ -n "$patch_name" ]; do
        [ -z "$patch_name" ] && continue
        case "$patch_name" in
            \#*) continue ;;
        esac
        if [ ! -f "$ROOT_DIR/patches/$patch_name" ]; then
            echo "Error: patch listed in series does not exist: $patch_name"
            exit 1
        fi
        echo "Applying: $patch_name"
        patch -Np1 --batch --forward --no-backup-if-mismatch -i "$ROOT_DIR/patches/$patch_name"
    done < "$SERIES_FILE"
fi
