# -- Collect kernel package artifacts.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$ROOT_DIR/output"

find "$ROOT_DIR/work" -maxdepth 1 -type f -name '*.deb' -exec cp -f {} "$ROOT_DIR/output/" \;
